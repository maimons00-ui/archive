# Tuya Device Configuration
# פרטי התקן Tuya - העתק קובץ זה ל-.env ומלא את הפרטים

# ========================================
# הגדרות חיבור מקומי (נדרש)
# ========================================

# Device ID - מזהה ההתקן
# ניתן למצוא באפליקציית Tuya Smart/Smart Life או ב-Tuya IoT Platform
TUYA_DEVICE_ID=your_device_id_here

# Device IP Address - כתובת IP של ההתקן ברשת המקומית
# ניתן לאתר על ידי הרצת: python energy_monitor.py --scan
TUYA_DEVICE_IP=192.168.1.100

# Local Key - מפתח מקומי להצפנה
# ניתן לקבל רק מ-Tuya IoT Platform (iot.tuya.com)
TUYA_LOCAL_KEY=your_local_key_here

# Protocol Version - גרסת פרוטוקול התקשורת
# בדרך כלל 3.3 להתקנים חדשים, 3.1 לישנים, 3.4 לחלק מהמודלים החדשים
TUYA_PROTOCOL_VERSION=3.3

# ========================================
# הגדרות Tuya Cloud API (אופציונלי)
# ========================================

# API Region - אזור השרת
# cn = סין, eu = אירופה, us = ארה"ב, in = הודו
TUYA_API_REGION=eu

# API Key ו-Secret - מ-Tuya IoT Platform
TUYA_API_KEY=
TUYA_API_SECRET=

# ========================================
# הגדרות חיבור
# ========================================

# Connection timeout in seconds
TUYA_TIMEOUT=10

# Number of retry attempts on failure
TUYA_RETRY_COUNT=3

# Polling interval in seconds (how often to read data)
TUYA_POLL_INTERVAL=2.0
